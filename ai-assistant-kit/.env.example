# ==============================================================================
# AI ASSISTANT KIT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` in your project root or set these variables in your
# hosting provider's dashboard (e.g. Vercel, Railway, Render, Docker).
# NEVER commit real keys or secrets into source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MULTI-PROVIDER AI KEYS (Server-Side Only)
# ------------------------------------------------------------------------------
# Primary Provider: OpenRouter (Universal Gateway)
# Obtain from: https://openrouter.ai/keys
# Scope: Server runtime only (never bundled into client assets)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Secondary Provider: Google Gemini
# Obtain from: https://aistudio.google.com/app/apikey
# Scope: Server runtime only
GEMINI_API_KEY=your-gemini-api-key-here

# Tertiary Provider: Groq (Ultra-fast Inference Fallback)
# Obtain from: https://console.groq.com/keys
# Scope: Server runtime only
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & VECTOR DATABASE (Supabase PostgreSQL / pgvector)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key for privileged server operations (credits, audit, RLS bypass where needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Public Anon Key for optional direct client queries
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. PAYMENTS & SUBSCRIPTIONS (Razorpay Test Mode)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/app/keys (Toggle 'Test Mode' first)
# Must begin with 'rzp_test_' in test mode
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
# Secret key used strictly on server for HMAC signature verification
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook secret configured in Razorpay Webhooks dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Force test mode safety check ('true' or 'false')
RAZORPAY_TEST_MODE=true

# ------------------------------------------------------------------------------
# 4. SERVER RUNTIME & SECURITY
# ------------------------------------------------------------------------------
# HTTP port for local Express server
PORT=3000
# Environment stage: 'development' or 'production'
NODE_ENV=development
# Secret key used to sign and verify session JWTs
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
# Argon2/Bcrypt hash for Platform Super Admin credentials (never plain text)
SUPER_ADMIN_PASSWORD_HASH=$2a$12$e8...placeholder_bcrypt_hash_for_superadmin...
# Comma-separated allowed client origins for CORS protection
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.vercel.app

# ------------------------------------------------------------------------------
# 5. ASSISTANT PERFORMANCE & FEATURE FLAGS
# ------------------------------------------------------------------------------
# Disable HMR during agent code modifications
DISABLE_HMR=false
# Maximum attachment upload size in bytes (10MB default)
MAX_FILE_SIZE_BYTES=10485760
# Per-provider request timeout in milliseconds
PROVIDER_TIMEOUT_MS=15000
